rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Users can read and write their own user document
    // Admins can read all user documents
    match /users/{userId} {
      allow read: if request.auth != null && 
        (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin(); // Admins can read all users
    }
    
    // Users can read and write their own projects
    // Admins can read all projects
    match /projects/{projectId} {
      allow read, write: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin(); // Admins can read all projects
    }
    
    // Users can read and write their own tasks
    // Admins can read all tasks
    match /tasks/{taskId} {
      allow read, write: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin(); // Admins can read all tasks
    }
    
    // Users can read and write their own time entries
    // Admins can read all time entries
    match /timeEntries/{timeEntryId} {
      allow read, write: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin(); // Admins can read all time entries
    }
    
    // Feedback collection - anyone can create, admins can read and update
    match /feedback/{feedbackId} {
      allow create: if true; // Anyone can submit feedback
      allow read, write: if isAdmin(); // Only admins can read and manage feedback
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 